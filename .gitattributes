# Archived primary sources must never be line-ending converted.
*.pdf   binary
*.png   binary
*.jpg   binary
*.pbix  binary

# Keep extracted source text byte-stable across platforms.
data/raw/*.txt -text
*.csv          -text

# index.html is the rendered output of the analysis, not its source.
# Exclude it from language stats so the repo reports what the work was.
# Anchored to the root, so dashboard/index.html, which is hand-written code, still counts.
/index.html linguist-documentation

# GitHub leaves SQL out of the language bar by default, as a data format.
# Here it is the analysis layer, so count it.
*.sql linguist-detectable
